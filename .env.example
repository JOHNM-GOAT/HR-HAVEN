# =========================================================
# AXIONHR HAVEN - SUPABASE CONFIGURATION
# =========================================================
# 1. Sign up at https://supabase.com and create a project
# 2. In Project Settings -> API, copy your Project URL & Anon Key
# 3. Rename or copy this file to `.env.local` and paste your keys below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # (Keep secret on server)
